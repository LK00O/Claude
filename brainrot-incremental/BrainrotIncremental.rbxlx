		Size = UDim2.new(1, -24, 0, 36),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = questCard,
	})
	ui.QuestBar = UIKit.ProgressBar(questCard, {
		Name = "Progress",
		Position = UDim2.new(0, 12, 1, -28),
