-- Prateleira 1: Barraca de Missões (iguais aos do Prado)
D("D_QuestReward", "Quest", 1, "Player", "Recompensa de Missão", "+10% de moedas nas recompensas de missão por nível", 10, 300, 1.72, "QuestReward", "Mult", 0.1)
D("D_QuestCooldown", "Quest", 1, "Player", "Espera de Missão", "-8% de espera entre missões por nível", 8, 300, 1.78, "QuestCooldown", "Pow", 0.92)

-- Prateleira 1: Barraca de Torretas
D("D_TurretCount", "Turret", 1, "Team", "Mais Torretas", "+1 torreta que o time pode posicionar no campo", 6, 150, 2.08, "TurretCount", "Add", 1)
