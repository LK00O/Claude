		b:Ball("Exhaust", 0.45, Vector3.new(x, 2.55, 1.1), b.Accent, Enum.Material.Neon)
	end
end

Details.TricTracBaraboom = function(b)
	-- Bombinha: faixa branca de dinamite, pavio e faísca acesa.
