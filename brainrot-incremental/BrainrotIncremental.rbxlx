	Public = "Qualquer jogador do servidor pode ver e entrar no grupo.",
	Friends = "Só os amigos do dono no Roblox (ou convidados) podem entrar.",
	Invite = "Só quem o dono convidar pode ver e entrar no grupo.",
}

