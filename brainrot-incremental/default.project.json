{
  "name": "BrainrotIncremental",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true
        }
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "BanningEnabled": true
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "ShadowSoftness": 0.2
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Main": {
        "$path": "src/ServerScriptService/Main.server.lua"
      },
      "Services": {
        "$path": "src/ServerScriptService/Services"
      },
      "World": {
        "$path": "src/ServerScriptService/World"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "BrainrotModels": {
        "$className": "Folder"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Main": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Main.client.lua"
        },
        "Controllers": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Controllers"
        },
        "UI": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/UI"
        }
      }
    },
    "SoundService": {
      "$className": "SoundService"
    }
  }
}
